TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNOpqRSTuvWXyz
TELEGRAM_CHAT_ID=987654321

# Dynamic threshold: 7 means 7%, not 0.07. Default mode: percent.
THRESHOLD_MODE=percent
THRESHOLD_PERCENT=7
# In hybrid mode, THRESHOLD is the minimum point gap after multipliers.
THRESHOLD=10
DISABLE_Q4_SIGNALS=true
# Overtime is always excluded. Multipliers apply only to four-quarter games.
Q1_THRESHOLD_MULTIPLIER=1
Q2_THRESHOLD_MULTIPLIER=1
Q3_THRESHOLD_MULTIPLIER=1
Q4_THRESHOLD_MULTIPLIER=1
# Additional multiplier for Q2 ALT only; lower values relax its threshold.
Q2_ALT_THRESHOLD_MULTIPLIER=1

# Check interval (seconds) - randomized to prevent bans
POLL_INTERVAL_MIN=25
POLL_INTERVAL_MAX=40
LIVE_POLL_SECONDS=4

# Max total signals allowed per match (1 per period; hard cap across match)
MAX_SIGNALS_PER_MATCH=3

# Database file
DB_PATH=basketball.db

# Log level (DEBUG/INFO/WARNING)
LOG_LEVEL=INFO

# AIScore basketball page
AISCORE_URL=https://m.aiscore.com/basketball
AISCORE_TIMEZONE=Europe/Istanbul

# Collection always uses a rolling next-24-hour window.
UPCOMING_DAYS_AHEAD=0
UPCOMING_MAX_MATCHES=0
UPCOMING_FETCH_TIMEOUT_SECONDS=300
UPCOMING_MATCH_TIMEOUT_SECONDS=75

# Max matches to scan per cycle
MAX_MATCHES_PER_CYCLE=80

# Page timeout (ms)
PAGE_TIMEOUT_MS=30000
# Adaptive live detail tabs start at two and use this value as the ceiling.
AISCORE_CONCURRENCY=4
LIVE_MATCH_TIMEOUT_SECONDS=90
LIVE_SCRAPE_TIMEOUT_SECONDS=180
# Never produce a signal from a market observation held in memory too long.
MAX_LIVE_OBSERVATION_AGE_SECONDS=20
# Reject an unchanged line after both score and game clock have materially advanced.
LIVE_LINE_STALE_SECONDS=90
LIVE_LINE_STALE_SCORE_DELTA=10
LIVE_LINE_STALE_GAME_MINUTES=2

# Finished-match checks are sequential for proxy stability.
FINISHED_PAGE_TIMEOUT_MS=20000
FINISHED_RETRY_ATTEMPTS=1

# --- Proxy (optional) ---
# Route Playwright browser traffic through a proxy.
# Tor (free):   PLAYWRIGHT_PROXY=socks5://127.0.0.1:9050
# HTTP proxy:   PLAYWRIGHT_PROXY=http://user:pass@host:port
PLAYWRIGHT_PROXY=

# --- Blacklist (optional) ---
# Comma-separated keywords to skip matches (case-insensitive)
# Checked against: match name, tournament/country, URL
# Example: NBA,China,CBA,WNBA
BLACKLIST=
